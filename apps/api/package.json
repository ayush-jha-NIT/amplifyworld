{
  "name": "@amplifyworld/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:generate && tsx watch src/server.ts",
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" prisma.config.ts --max-warnings=0",
    "test": "pnpm db:generate && tsx --test src/*.test.ts src/db/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "tsx scripts/database.ts deploy",
    "db:migrate:status": "tsx scripts/database.ts status",
    "db:migrate:dev": "tsx scripts/database.ts dev",
    "test:database": "tsx scripts/test-database.ts"
  },
  "dependencies": {
    "@amplifyworld/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^8.57.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}

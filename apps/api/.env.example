NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Module 11: leave blank for builds, tests and the current health-only API.
# Runtime: Neon pooled URL with a restricted application role.
# Require sslmode=require (upgraded to verify-full) or sslmode=verify-full.
DATABASE_URL=
# Migration job only: direct/unpooled URL with the schema-owner role.
# Do not put this credential in the web app or the running API service.
DIRECT_URL=
# Local migration authoring only: a DIFFERENT disposable local database.
SHADOW_DATABASE_URL=
# Optional local integration tests: local postgres maintenance DB on an isolated
# test server with permission to create/drop databases and roles. Never Neon.
TEST_DATABASE_ADMIN_URL=
# Module 13. Email delivery is explicitly disabled unless all credentials
# and verified sender/recipient addresses are configured privately.
INQUIRY_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_NOTIFY_EMAIL=
INQUIRY_NOTIFICATION_BATCH_SIZE=5
# A private random string of at least 32 characters, stable across API replicas,
# used only for HMAC hashing IP-based rate-bucket identities. Never log it.
INQUIRY_ABUSE_HASH_SECRET=
# Separate scheduled retention task, only after legal/privacy review:
INQUIRY_RETENTION_CLEANUP_ENABLED=false

# Module 12: all disabled by default. Activate only after migrations, reviewed
# privacy/retention policy, protected network deployment and verified API config.
INQUIRY_COLLECTION_ENABLED=false
INQUIRY_PRIVACY_POLICY_APPROVED=false
# Explicit whole days (1–365), no implicit retention choice:
INQUIRY_RETENTION_DAYS=
# Set only after reviewing the trusted Render proxy boundary:
TRUST_PROXY_HOPS=0

# Module 14: external HTTPS OpenID Connect provider; RS256 signed access tokens.
# No API keys or browser tokens are stored in the database.
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_AUDIENCE=
ADMIN_OIDC_JWKS_URL=
# First administrator must be explicitly provisioned by operator (one time).
ADMIN_BOOTSTRAP_CONFIRM=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_SUBJECT=
ADMIN_BOOTSTRAP_DISPLAY_NAME=

# Module 17: false until the independent scheduled Resend delivery job actually
# exists and can be verified. When true, run worker at a reviewed cadence.
INQUIRY_NOTIFICATION_WORKER_CONFIRMED=false

NEXT_PUBLIC_API_URL=http://localhost:4000
# Public, verified business WhatsApp number in international format (digits, optional leading +).
# When unset or invalid, WhatsApp CTAs remain visibly unavailable and never link to a made-up number.
# NEXT_PUBLIC_WHATSAPP_NUMBER=
# Module 12 inquiry API is implemented but stays disabled until backend collection,
# privacy/retention and a verified HTTPS API endpoint are ready.
NEXT_PUBLIC_INQUIRIES_ENABLED=false

# Module 14: public OIDC Authorization Code + PKCE endpoints (NOT client secrets).
# Register https://<your-web-domain>/admin as allowed redirect URI.
NEXT_PUBLIC_ADMIN_OIDC_CLIENT_ID=
NEXT_PUBLIC_ADMIN_OIDC_AUTH_URL=
NEXT_PUBLIC_ADMIN_OIDC_TOKEN_URL=

{
  "name": "amplifyworld",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @amplifyworld/shared build && pnpm --parallel --filter @amplifyworld/web --filter @amplifyworld/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "pnpm --filter @amplifyworld/api db:generate",
    "db:validate": "pnpm --filter @amplifyworld/api db:validate",
    "db:migrate:deploy": "pnpm --filter @amplifyworld/api db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @amplifyworld/api db:migrate:status",
    "db:migrate:dev": "pnpm --filter @amplifyworld/api db:migrate:dev",
    "test:database": "pnpm --filter @amplifyworld/api test:database",
    "notifications:dispatch": "pnpm --filter @amplifyworld/api notifications:dispatch",
    "retention:prune": "pnpm --filter @amplifyworld/api retention:prune",
    "admin:bootstrap": "pnpm --filter @amplifyworld/api admin:bootstrap"
  }
}
